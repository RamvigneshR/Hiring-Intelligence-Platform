cat > .env.dev << 'EOF'
DB_USER=postgres
DB_PASS=yourlocalpassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hiring_platform
WEBSITE_URL=https://www.arbeitnow.com/api/job-board-api
PAGES_TO_RUN=1
STORAGE_PATH=./arbeitnow_json
LOG_DIR=./logs
EOF

cat > .env.prod.example << 'EOF'
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=5432
DB_NAME=
WEBSITE_URL=https://www.arbeitnow.com/api/job-board-api
PAGES_TO_RUN=5
STORAGE_PATH=/var/data/arbeitnow_json
LOG_DIR=/var/log/hiring_platform
EOF